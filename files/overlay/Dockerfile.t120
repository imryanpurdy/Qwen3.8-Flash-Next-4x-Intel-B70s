# ============================================================================
# Dockerfile.t120 — reproduces the pinned serving image stage-v24h2:rollback-t120
# (GHCR: ghcr.io/imryanpurdy/qwen38-flash-next-b70, digest
#  sha256:0ca8598598ba84614dede126141070665fbaf3c68205c0b8567cddb2dca66fc2).
#
# The t120 delta over its parent stage-v24h2:rollback is ONE LINE:
#   vllm/v1/ple_offload/connector.py:370  PLE staging deadline 2.0s -> 120.0s
# (ledger B4T-IMAGE 2026-09-22T12:54:02Z; without it, 98K-context prefill
#  tears embeddings — docs/rebuild/2026-09-22-staging-window-2s-to-120s.md).
#
# Full from-scratch lineage of the parent: files/overlay/Dockerfile.flashnext
# (intel/omix:0.4.0-devel-ubuntu24.04 + peakcrosser7/vllm fork @ 357e0544).
#
# Build (from repo root):
#   docker build -f files/overlay/Dockerfile.t120 -t stage-v24h2:rollback-t120 .
#
# The build FAILS unless the patched connector md5 equals the pushed image's
# connector md5 (61d647257e39c0d1c43866375347cc77, verified 2026-09-23 by
# extracting /opt/venv/lib/python3.12/site-packages/vllm/v1/ple_offload/connector.py
# from the pushed image).
# ============================================================================
FROM stage-v24h2:rollback

COPY files/overlay/patches/t120-connector-staging-120s.patch /tmp/t120.patch

RUN set -eux; \
    CONN=/opt/venv/lib/python3.12/site-packages/vllm/v1/ple_offload/connector.py; \
    test "$(md5sum "$CONN" | cut -d" " -f1)" = "87b25f2df215cd8f12ff5c418e2321a5" \
      || { echo "FATAL: parent connector md5 mismatch (expected pre-patch 87b25f2df215cd8f12ff5c418e2321a5)"; exit 11; }; \
    cd /opt/venv/lib/python3.12/site-packages && patch -p1 < /tmp/t120.patch; \
    test "$(md5sum "$CONN" | cut -d" " -f1)" = "61d647257e39c0d1c43866375347cc77" \
      || { echo "FATAL: patched connector md5 != pushed-image connector 61d647257e39c0d1c43866375347cc77"; exit 12; }; \
    rm -f /tmp/t120.patch
