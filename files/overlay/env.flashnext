MODEL_ID="Intel/Qwen3.8-Flash-Next-W4A16-AutoRound"
SERVED_MODEL_NAME="qwen3.8-flash-next"
PORT=8021
MAX_MODEL_LEN=4352
MAX_NUM_SEQS=16
MAX_NUM_BATCHED_TOKENS=2048
TENSOR_PARALLEL_SIZE=4
ENABLE_EXPERT_PARALLEL=true
MTP_NUM_SPECULATIVE_TOKENS=0
PLE_CPU_OFFLOAD_GB=1.0
GRAPH_MODE=eager
PREFLIGHT_XPU_COUNT=4
PREFLIGHT_RAM_GB=100
PREFLIGHT_SWAP_GB=64
PREFLIGHT_DISK_GB=30
PREFLIGHT_ROOT_GB=40
WEDGE_WATCHDOG_INTERVAL=60
WEDGE_WATCHDOG_RETRIES=3
IMAGE=flashnext-v25:0.1
HF_HOME=/home/bonz/hf-int4
HF_TOKEN=""
# PERMANENT CONFIG (oneCCL#212): stale cached ZE IPC handle hang; no fix documented in oneCCL 2021.x/2022.x release notes - required until Intel documents the fix. Do NOT strip as legacy. MANDATORY before any max_model_len raise (large-context concurrent load = marcorigodanzo wedge terrain).
EXTRA_DOCKER_ARGS="--cap-add SYS_RESOURCE -e VLLM_XPU_ENABLE_XPU_GRAPH=1 -e VLLM_USE_V2_MODEL_RUNNER=1 -e VLLM_KV_CACHE_LAYOUT=BLHNC -e SYCL_UR_USE_LEVEL_ZERO_V2=0 -p 8021:8021 -e PYTHONFAULTHANDLER=1 -e VLLM_PLE_CPU_OFFLOAD=1 -e VLLM_XPU_GDN_SERIAL_SPEC_DECODE=0 -e VLLM_XPU_GDN_NATIVE_SPEC_RECURRENT_SERIAL_EXACT=1 -e VLLM_SPU_GDN_SPEC_PERSISTENT_SCRATCH=1 -e VLLM_XPU_GDN_NATIVE_SPEC_COMPLETION_BARRIER=1 -e VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS=900 -e CCL_ZE_CACHE_OPEN_IPC_HANDLES=0"
EXTRA_VLLM_ARGS="--enable-ep-weight-filter --quantization inc -O 0 --gpu-memory-utilization 0.75"
VLLM_WEIGHT_OFFLOADING_DISABLE_PIN_MEMORY=0
CAP_SIZES_LIST=1,2,3,4,5,6,7,8,12,16
