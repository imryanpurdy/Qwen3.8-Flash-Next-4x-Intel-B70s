+void common_prompt_checkpoint::load_tgt_dev(
+        llama_context * ctx,
+        llama_seq_id seq_id,
+        llama_state_seq_flags flags) const {
+    if (ctx == nullptr) {
+        return;
+    }
+
+    if (dev_tgt) {
+        if (llama_state_seq_snapshot_load(ctx, seq_id)) {
+            return;
+        }
+        GGML_ABORT("device recurrent-state snapshot was taken but could not be restored\n");
+    }
+
+    load_tgt(ctx, seq_id, flags);
 }
 
