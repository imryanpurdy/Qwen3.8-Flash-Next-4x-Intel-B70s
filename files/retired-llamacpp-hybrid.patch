+// Co-batched speculative verification.
+//
+// llama_batch_allocr::split_equal() advances every sequence in a ubatch in LOCKSTEP: it
+// stops expanding as soon as ANY sequence runs out of tokens, and then the n_keep_tail
+// filter (= n_rs_seq + 1) defers every sequence whose remaining count is nonzero but below
+// that, keeping only the prefix before the first such sequence. So a set of slots holding
+// UNEQUAL numbers of draft tokens gets torn apart into several ubatches -- very often one
+// sequence each -- and every one of them pays the target forward pass's fixed cost again.
+//
+// Measured on this box at PAR=4 (llama.cpp-fwd5, artifacts/flashnext/FWD_BISECT.md):
+//   target pass ~= 23.8 ms fixed + 7.47 ms/token
+//   without MTP  98.1% of target passes carried all 4 slots  -> 13.43 ms/token
+//   with MTP     85.2% carried exactly ONE slot              -> 13.95 ms/token
+//   4 slots x 4 tokens co-batched into one pass              ->  9.31 ms/token
+// which is why speculation measured as a LOSS at PAR=4 while its acceptance was 0.899 and
+// its per-token verification cost was falling normally. Nothing was slow; the batch was
+// being split.
+//
+// The fix is to keep every drafting sequence the same length, so split_equal can pack them
+// all into one pass. That means not letting p_min terminate one sequence early while its
+// peers keep going: a token below p_min is drafted anyway and will simply be rejected,
+// costing one token of marginal verification (7.47 ms, shared across the batch) instead of
+// an entire extra forward pass (23.8 ms fixed, paid alone).
+//
+// Only worth doing when there is something to co-batch with, so the default is automatic:
+// on when more than one sequence is drafting this cycle, off at PAR=1 where p_min is doing
+// useful work and there is no batch to pack. LLAMA_SPEC_UNIFORM=0/1 forces it either way.
+static bool spec_uniform_draft_len(int n_drafting) {
+    static const int v = [] {
+        const char * e = getenv("LLAMA_SPEC_UNIFORM");
+        return e ? atoi(e) : -1;   // -1 = auto
+    }();
+
+    if (v == 0) {
+        return false;
+    }
+    if (v > 0) {
+        return true;
+    }
+
+    return n_drafting > 1;
+}
+
 // DFlash: block-diffusion drafting with a draft-side KV cache injection
 struct common_speculative_impl_draft_dflash : public common_speculative_impl {
     common_params_speculative_draft params;
@@ -1718,6 +1763,12 @@ struct common_speculative_impl_draft_mtp : public common_speculative_impl {
             }
         }
 
+        // decided once from this cycle's drafting set: every sequence must run to the same
+        // length or split_equal() tears the verification batch apart (see
+        // spec_uniform_draft_len). Uniform mode overrides the per-sequence adaptive length,
+        // which would otherwise reintroduce unequal drafts.
+        const bool uniform_len = spec_uniform_draft_len(n_drafting);
+
         int i = 0;
 
         while (n_drafting > 0) {
@@ -1773,8 +1824,22 @@ struct common_speculative_impl_draft_mtp : public common_speculative_impl {
                 // add drafted token for each sequence
                 const llama_token id = cur_p->data[0].id;
 
-                // only collect very high-confidence draft tokens
-                if (cur_p->data[0].p < params.p_min) {
+                // LLAMA_DRAFT_CONF=1: the draft head's top-1 probability at every draft
+                // step. Bimodal => the head is honestly uncertain and p_min is doing its
+                // job. Uniformly mediocre => the head is badly conditioned, which would
+                // point at the hidden-state handoff rather than at p_min.
+                if (getenv("LLAMA_DRAFT_CONF")) {
+                    printf("DRAFTCONF pos=%d p=%.6f p2=%.6f sofar=%d\n",
+                           i, cur_p->data[0].p,
+                           cur_p->size > 1 ? cur_p->data[1].p : 0.0f,
+                           (int) dparams.at(seq_id).result->size());
+                    fflush(stdout);
+                }
+
+                // only collect very high-confidence draft tokens -- unless this cycle is
+                // co-batching several sequences, where stopping one early costs the whole
+                // batch an extra target pass (see spec_uniform_draft_len)
+                if (cur_p->data[0].p < params.p_min && !uniform_len) {
                     drafting[seq_id] = false;
                     n_drafting--;
 
@@ -1788,7 +1853,7 @@ struct common_speculative_impl_draft_mtp : public common_speculative_impl {
 
                 result.push_back(id);
 
-                if (n_draft_eff <= (int) result.size()) {
+                if ((uniform_len ? params.n_max : n_draft_eff) <= (int) result.size()) {
                     drafting[seq_id] = false;
                     n_drafting--;
                     continue;
