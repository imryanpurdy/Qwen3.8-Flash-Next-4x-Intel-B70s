+// Resolve the recurrent memory behind a context, if it has one. qwen4exp and the other
+// gated-delta archs use llama_memory_hybrid (attention KV + recurrent); pure recurrent
+// models expose it directly.
+static llama_memory_recurrent * llama_get_mem_recr(llama_context * ctx) {
+    llama_memory_i * mem = ctx->get_memory();
+    if (!mem) {
+        return nullptr;
+    }
+    if (auto * hyb = dynamic_cast<llama_memory_hybrid *>(mem)) {
