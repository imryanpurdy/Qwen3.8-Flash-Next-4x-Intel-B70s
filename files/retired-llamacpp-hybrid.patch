+// ---- device-resident snapshot -------------------------------------------------------
+//
+// Rolling back a rejected speculative draft means restoring the recurrent state, and a
+// recurrent state is a fold: there is no inverse, only a copy taken beforehand. The
+// generic path serialises it to host bytes, so on a discrete GPU every rejection is a
+// full PCIe round trip -- measured here at 124.88 MiB / 6.6 GB/s = 19.75 ms, once per
+// speculative cycle, 27% of decode time. The snapshot below lives in the same backend
+// buffer as the state itself, so the same copy is device-to-device at 894 GB/s: 0.29 ms.
+//
+// One cell per sequence. Column `cells[seq_id].tail` of the live tensor is copied to
+// column `seq_id` of the snapshot, so sequences are independent and PAR > 1 is safe.
+
+// a one-column view of an already-allocated tensor, valid for ggml_backend_tensor_copy
+static ggml_tensor llm_rs_col(ggml_tensor * t, int64_t col) {
+    ggml_tensor v = *t;
+    v.ne[1] = 1; v.ne[2] = 1; v.ne[3] = 1;
+    v.nb[2] = v.nb[1];
+    v.nb[3] = v.nb[1];
+    v.op = GGML_OP_NONE;
+    for (int i = 0; i < GGML_MAX_SRC; ++i) {
+        v.src[i] = nullptr;
+    }
+    v.view_src  = t->view_src ? t->view_src : t;
+    v.view_offs = (size_t) col * t->nb[1];
+    v.data      = (char *) t->data + (size_t) col * t->nb[1];
+    return v;
+}
+
+bool llama_memory_recurrent::snapshot_init() {
+    if (!snap_r_l.empty()) {
+        return true;
+    }
+    if (snap_failed) {
+        return false;
+    }
+
+    const int32_t n_layer = (int32_t) r_l.size();
+
+    std::map<ggml_backend_buffer_type_t, ggml_context *> ctx_map;
+    std::vector<ggml_context_ptr> ctxs;
+
+    snap_r_l.assign(n_layer, nullptr);
+    snap_s_l.assign(n_layer, nullptr);
+    snap_p_l.assign(n_layer, nullptr);
+
+    for (int32_t il = 0; il < n_layer; ++il) {
+        if (!r_l[il] || !s_l[il]) {
+            continue;
+        }
+
+        ggml_backend_buffer_type_t buft = ggml_backend_buffer_get_type(r_l[il]->buffer);
+
+        auto it = ctx_map.find(buft);
+        if (it == ctx_map.end()) {
+            ggml_init_params params = {
+                /*.mem_size   =*/ size_t(2*n_layer*ggml_tensor_overhead()),
+                /*.mem_buffer =*/ NULL,
+                /*.no_alloc   =*/ true,
+            };
+            ggml_context * ctx = ggml_init(params);
+            if (!ctx) {
+                snap_failed = true;
+                snap_r_l.clear(); snap_s_l.clear();
+                return false;
+            }
+            ctxs.emplace_back(ctx);
+            ctx_map.emplace(buft, ctx);
+            it = ctx_map.find(buft);
+        }
+
+        // sized from the live tensors, not hparams: on this lineage the PLE conv history has
+        // its own row (p_l) whose width is per-layer, and r rows can differ per layer too
+        snap_r_l[il] = ggml_new_tensor_2d(it->second, r_l[il]->type, r_l[il]->ne[0], n_seq_max);
+        snap_s_l[il] = ggml_new_tensor_2d(it->second, s_l[il]->type, s_l[il]->ne[0], n_seq_max);
+        ggml_format_name(snap_r_l[il], "snap_r_l%d", il);
+        ggml_format_name(snap_s_l[il], "snap_s_l%d", il);
+        if (il < (int32_t) p_l.size() && p_l[il]) {
+            snap_p_l[il] = ggml_new_tensor_2d(it->second, p_l[il]->type, p_l[il]->ne[0], n_seq_max);
+            ggml_format_name(snap_p_l[il], "snap_p_l%d", il);
+        }
+    }
+
+    size_t total = 0;
+    for (auto & [buft, ctx] : ctx_map) {
+        ggml_backend_buffer_t buf = ggml_backend_alloc_ctx_tensors_from_buft(ctx, buft);
+        if (!buf) {
+            LLAMA_LOG_WARN("%s: failed to allocate the recurrent-state snapshot; "
+                           "speculative rollback will fall back to the host path\n", __func__);
+            snap_failed = true;
+            snap_r_l.clear(); snap_s_l.clear();
+            return false;
+        }
+        ggml_backend_buffer_clear(buf, 0);
+        total += ggml_backend_buffer_get_size(buf);
+        // hand the context over to the same owner as the buffer
+        for (auto & c : ctxs) {
+            if (c.get() == ctx) {
+                snap_ctxs_bufs.emplace_back(std::move(c), buf);
+                break;
+            }
+        }
+    }
+
+    snap_ok.assign(n_seq_max, 0);
+    snap_pos.assign(n_seq_max, -1);
+    snap_tail.assign(n_seq_max, -1);
+
+    LLAMA_LOG_INFO("%s: recurrent-state snapshot = %7.2f MiB (%u seqs, device-resident: "
+                   "speculative rollback stays off the bus)\n",
+                   __func__, total/1024.0/1024.0, n_seq_max);
+    return true;
+}
+
+bool llama_memory_recurrent::snapshot_save(llama_seq_id seq_id) {
+    if (seq_id < 0 || (uint32_t) seq_id >= n_seq_max) {
+        return false;
+    }
+    if (!snapshot_init()) {
+        return false;
+    }
+
+    const int32_t tail = cells[seq_id].tail;
+    if (tail < 0) {
+        return false;
+    }
+
+    for (size_t il = 0; il < r_l.size(); ++il) {
+        if (!r_l[il] || !snap_r_l[il]) {
+            continue;
+        }
+        ggml_tensor src_r = llm_rs_col(r_l[il],      tail);
+        ggml_tensor dst_r = llm_rs_col(snap_r_l[il], seq_id);
+        ggml_tensor src_s = llm_rs_col(s_l[il],      tail);
+        ggml_tensor dst_s = llm_rs_col(snap_s_l[il], seq_id);
+        ggml_backend_tensor_copy(&src_r, &dst_r);
+        ggml_backend_tensor_copy(&src_s, &dst_s);
+        if (il < p_l.size() && p_l[il] && snap_p_l[il]) {
+            ggml_tensor src_p = llm_rs_col(p_l[il],      tail);
+            ggml_tensor dst_p = llm_rs_col(snap_p_l[il], seq_id);
+            ggml_backend_tensor_copy(&src_p, &dst_p);
+        }
+    }
+
+    snap_pos [seq_id] = cells[tail].pos;
+    snap_tail[seq_id] = tail;
+    snap_ok  [seq_id] = 1;
+    return true;
+}
+
+bool llama_memory_recurrent::snapshot_load(llama_seq_id seq_id) {
+    if (!snapshot_valid(seq_id)) {
+        return false;
+    }
+
+    const int32_t tail = cells[seq_id].tail;
+    if (tail < 0) {
+        return false;
+    }
+
+    // The snapshot restores in place, so it is only valid if the sequence still occupies
+    // the cell it did at save time. If it moved, the caller must use the host path, which
+    // rebuilds the cells from scratch.
+    if (tail != snap_tail[seq_id]) {
+        return false;
+    }
+
+    for (size_t il = 0; il < r_l.size(); ++il) {
+        if (!r_l[il] || !snap_r_l[il]) {
+            continue;
+        }
+        ggml_tensor src_r = llm_rs_col(snap_r_l[il], seq_id);
+        ggml_tensor dst_r = llm_rs_col(r_l[il],      tail);
+        ggml_tensor src_s = llm_rs_col(snap_s_l[il], seq_id);
+        ggml_tensor dst_s = llm_rs_col(s_l[il],      tail);
+        ggml_backend_tensor_copy(&src_r, &dst_r);
+        ggml_backend_tensor_copy(&src_s, &dst_s);
+        if (il < p_l.size() && p_l[il] && snap_p_l[il]) {
+            ggml_tensor src_p = llm_rs_col(snap_p_l[il], seq_id);
+            ggml_tensor dst_p = llm_rs_col(p_l[il],      tail);
+            ggml_backend_tensor_copy(&src_p, &dst_p);
+        }
+    }
+
+    // rewind the bookkeeping too, or seq_rm() below will see a partial intersection
+    cells[tail].pos = snap_pos[seq_id];
+
+    return true;
+}
+
+bool llama_memory_recurrent::snapshot_valid(llama_seq_id seq_id) const {
+    return seq_id >= 0 && (uint32_t) seq_id < n_seq_max
+        && !snap_r_l.empty() && seq_id < (llama_seq_id) snap_ok.size() && snap_ok[seq_id];
+}
