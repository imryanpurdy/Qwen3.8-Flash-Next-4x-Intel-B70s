+// LLAMA_SPEC_PROF=1: raw timestamped events, one per step. Cycles are reconstructed
+// offline (a cycle is the span between consecutive `acc` events), so the analysis does not
+// depend on where control flow happens to return -- which is what invalidated the previous
+// accumulator-based version when the rollback path changed.
+struct spec_prof {
+    static bool on() {
+        static const bool v = getenv("LLAMA_SPEC_PROF") != nullptr;
+        return v;
+    }
+    static int64_t now() { return ggml_time_us(); }
+    static void ev(const char * what, int a, int b, int64_t t0) {
+        if (!on()) return;
+        const int64_t t1 = now();
+        printf("SPECEV %s a=%d b=%d t0=%lld dur=%lld\n", what, a, b,
+               (long long) t0, (long long) (t1 - t0));
+        fflush(stdout);
+    }
+};
