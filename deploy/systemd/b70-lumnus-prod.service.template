#!/usr/bin/env bash
# ============================================================================
# b70-lumnus-prod.service — systemd template for the production lane.
#
# Runs scripts/start.sh (full gate path) after docker is up, on boot and on
# demand. The launcher itself owns every gate (preflight, weights identity,
# XPU gate, image gate, READY receipt) and spawns the wedge watchdog; this
# unit only sequences it behind docker and restarts on failure with backoff.
#
# Install: sudo ./scripts/install-systemd.sh   (see that script for details)
# Status : systemctl status b70-lumnus-prod
# Logs   : journalctl -u b70-lumnus-prod -f   (and scripts/status.sh)
# Stop   : systemctl stop b70-lumnus-prod      (runs scripts/stop.sh: watchdog
#                                               first, then the container)
#
# Notes:
# - ExecStop uses the stop path with a generous timeout: a graceful watchdog
#   TERM + container rm normally takes seconds; TimeoutStopSec covers a slow
#   docker teardown.
# - Type=oneshot means systemd will NOT re-run a failed start (Restart= is
#   inert for oneshot). Start-time failure fails the unit loudly; runtime
#   wedge recovery is the watchdog's job (bounded retries, then a loud exit).
# - The unit is Type=oneshot with RemainAfterExit=yes: start.sh blocks until
#   READY (~4-5 min), then exits 0. "systemctl is-active" tracks the lane's
#   launched-or-not state; liveness itself is the watchdog's job.
# - LANE_DIR is NOT set here: the unit assumes the repo checkout IS the lane
#   root (WorkingDirectory). The watchdog's restart command resolves to the
#   same checkout (PROD_RESTART_CMD default <repo>/scripts/start.sh --launch).
# ============================================================================

[Unit]
Description=Qwen3.8-Flash-Next production lane (Lumnus b70-flash-next, 4x Intel B70)
Documentation=file://%REPO_ROOT%/docs/operations/production-lane.md
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Watchdog survival across the start-script exit: start.sh spawns the wedge
# watchdog with nohup; it lands in THIS unit's control group. That is safe
# because a Type=oneshot+RemainAfterExit unit does NOT tear its cgroup down
# when ExecStart exits — the watchdog (and the container) keep running while
# the unit sits "active (exited)". The cgroup is only cleaned on an explicit
# `systemctl stop`, and by then ExecStop=stop.sh has ALREADY stopped the
# watchdog deliberately (watchdog TERM first, then the container) — so the
# stop order contract is preserved and no orphan survives a stop.
KillMode=mixed
User=%USER%
Group=%USER%
WorkingDirectory=%REPO_ROOT%
# --replace: at boot the previous container may still exist (unclean shutdown);
# start.sh is explicitly allowed to replace it. Without this flag start.sh
# refuses to touch a live container (2026-10-05 guard law).
ExecStart=%REPO_ROOT%/scripts/start.sh --replace
ExecStop=%REPO_ROOT%/scripts/stop.sh
TimeoutStartSec=1200
TimeoutStopSec=120
# NOTE: Type=oneshot services are NEVER restarted by systemd — Restart= would
# be inert here (and misleading). Runtime wedge recovery is the watchdog's
# job (it survives the start-script exit — see the watchdog note above); a
# FAILED start (exit != 0) fails the boot unit loudly and the lane stays down
# until a human or the watchdog's own restart path acts.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=b70-lumnus-prod

[Install]
WantedBy=multi-user.target
