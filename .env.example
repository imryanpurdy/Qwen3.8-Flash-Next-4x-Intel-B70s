# ============================================================================
# .env.example — Lumnus b70-flash-next production lane (4x Intel Arc Pro B70)
#
# cp .env.example .env — every value below is the measured/verified production
# default (sanitized: host paths are placeholders; adjust to your rig).
# Engine line: Lumnus b70-flash-next (vLLM v0.30.0 + patch series 0001-0019),
# wtdcode/Qwen3.8-Flash-Next-AWQ-W4A16, INT8 PLE from NVMe, TP4+EP, qwen-256k.
# Knob meanings: README "Configuration"; limits: README "Known limits".
# ============================================================================

# --- Required ----------------------------------------------------------------

# Container image of record (local build; see README — Quick start).
IMAGE="b70-lumnus-trial:v1"

# Container name (docker --name; start/stop/status all key off it).
CONTAINER_NAME="b70-lumnus-prod"

# OpenAI-compatible API port (host network — the container binds this directly).
PORT=8022

# Model id served at /v1/models (watchdog health probe greps for this string).
SERVED_MODEL_NAME="qwen-256k"

# KV native-offload pool, GiB TOTAL over the TP ranks (not per-GPU — 4x the
# per-GPU number). Power of two (the awq env header). Production: 64.
KV_OFFLOADING_SIZE=64

# Lane root: runtime state (.run/ logs, pidfiles, wedge captures) lives under
# $LANE_DIR/.run/. Default: the repo root. Point it elsewhere to run several
# lanes from one checkout.
#LANE_DIR="/path/to/your/checkout"

# Weights: local AWQ snapshot tree (bind-mounted read-only at /data/model).
# Identity-gated at start: config.json + *.safetensors must exist, no
# symlinked HF-cache snapshots (they dangle inside the container mount).
MODEL_PATH="/data/awq-snapshot"

# PLE table for the Qwen4Exp MTP layer. The AWQ snapshot's entry may be a
# symlink into the BF16 tree — it must resolve on the HOST at start time.
PLE_TABLE_PATH="/data/awq-snapshot/ple_table_qwen4exp.pt"

# Engine env file (docker --env-file): UR_L0_V2_FORCE_DISABLE_COPY_OFFLOAD,
# ONEAPI_DEVICE_SELECTOR, B70_PLE_INT8*, B70_DEFAULT_*, PLE_TABLE_PATH, ...
# Relative paths resolve against the repo root. See lumnus.env.example.
LUMNUS_ENV="lumnus.env"

# Serve flags file (one flag per line; "flag value" may share a line).
# Single source of truth for --max-model-len / --max-num-seqs /
# --tensor-parallel-size — start.sh parses and gates them before touching
# any service (MML <= 262144, MNS <= 32, TP == 4). See serve-args.example.
SERVE_ARGS="serve-args"

# --- Bind mounts (host side; container side is fixed) -------------------------
# /ple/bf16  — BF16 PLE tree (cross-check reference + snapshot symlink target)
# /ple/int8  — INT8 rowscale PLE table dir (served from NVMe, hot path)
# /data-awq  — original AWQ weights tree (reference/rollback)
# $LANE_CACHE — container-side compile/tool cache (persistent across boots;
#               torch.compile cache reuse is why reboots are ~4-5 min)
PLE_BF16_DIR="/data/ple-bf16"
PLE_INT8_DIR="/data/int8-ple"
AWQ_ORIG_DIR="/data-awq"
LANE_CACHE="/data/lanes/_shared/cache"

# Optional: parent dir of the BF16 tree, bind-mounted at the same path
# (snapshot PLE symlink resolution + cross-check tools inside the container).
#HF_DEVAN_MIRROR="/data/hf-mirror"

# Optional: serve-config.json mounted read-only at
# /opt/b70-flashnext/serve-config.json (default: ./serve-config.json).
#SERVE_CONFIG="serve-config.json"

# --- Engine env overrides passed with ${VAR:+-e VAR=$VAR} ---------------------
# Space-separated list of OPTIONAL engine flags to pass through from this
# .env. The ${VAR:+...} pattern omits unset vars entirely — an EMPTY value
# reaching the container is not "unset" (oneCCL parses it and dies at worker
# init). Bulk engine env rides $LUMNUS_ENV instead.
#EXTRA_ENGINE_ENV_VARS="UR_L0_V2_FORCE_DISABLE_COPY_OFFLOAD B70_PLE_INT8 B70_PLE_INT8_NVME B70_PLE_DIRECT_PINNED B70_THINKING_BUDGET"

# --- Container sizing -----------------------------------------------------------
SHM_SIZE="16g"

# --- Preflight floors (start.sh gate; platform of record) -----------------------
PREFLIGHT_XPU_COUNT=4        # level_zero:gpu devices required (TP4)
PREFLIGHT_RAM_GB=100         # MemAvailable floor, GiB
PREFLIGHT_SWAP_GB=64         # swap ON and >= this, GiB
PREFLIGHT_ROOT_GB=40         # free space on / , GiB
PREFLIGHT_PLE_NVME_GB=100    # free space on the PLE NVMe mount, GiB (hot path)
                             # weights-mount free space is REPORT-ONLY (warn
                             # < 30 GiB; hard floor 2 GiB) — serving reads a
                             # local tree, no download headroom needed.

# --- Readiness ------------------------------------------------------------------
READY_WAIT_SECONDS=900       # max wait for /v1/models (boot is ~4-5 min)

# --- Wedge watchdog (mandatory; double opt-out: DISABLE=1 AND --no-preflight) ---
WEDGE_WATCHDOG_INTERVAL=60   # probe interval, seconds
WEDGE_WATCHDOG_RETRIES=3     # bounded restarts before giving up loudly
#WEDGE_WATCHDOG_DISABLE=0
#LOAD_SAMPLE_S=30           # load-guard: gap between the two /metrics samples
#PROD_RESTART_CMD=          # watchdog restart command (default:
                           # <repo>/scripts/start.sh --launch — set explicitly
                           # if you deploy scripts to a different directory)

# Values verified against live production files on the rig; excerpts <=30 lines; read-only session.
