# ============================================================================
# .env.example — Qwen3.8-Flash-Next on 4x Intel Arc Pro B70
#
# cp .env.example .env — every value below is the measured/verified line.
# Knob meanings: README "Configuration"; limits: README "Known limits".
#
# Engine line: vLLM fork devan-carlin/vllm@xpu-qwen4exp (a69fba21), image
# built FROM intel/omix:0.4.0-devel-ubuntu24.04.
#
# Model-variant notice: this is the DENSE-FULL-CONTEXT QSA variant (indexer
# weights dropped) — a DIFFERENT model variant from the sparse-QSA
# checkpoints. Fidelity verdict: docs/notes/dense-qsa-model-variant.md.
#
# PRODUCTION CHECKPOINT (2026-10-04): this line serves the
# wtdcode/Qwen3.8-Flash-Next-AWQ-W4A16 checkpoint — NOT Intel's builds, and
# not the W4A16 checkpoint below. Why: the W4A16 checkpoint's int4 attention
# path misreads long-context values (6/24 cold, 4/24 warm at 118K) while the
# AWQ checkpoint reads them at 0-1/24 (see docs/notes/measured-results.md,
# "checkpoint decision"). Keep a W4A16 tree on disk as the documented
# rollback: switching back is one MODEL_PATH edit + one start.sh cycle.
# ============================================================================

# --- Model & weights (local tree; bind-mounted read-only) --------------------
# PRODUCTION: wtdcode/Qwen3.8-Flash-Next-AWQ-W4A16 (AWQ W4A16, 5 shards + MTP
# head, ~169 GB on disk / ~74 GiB resident across 4 ranks).
# Download: huggingface-cli download wtdcode/Qwen3.8-Flash-Next-AWQ-W4A16 --local-dir <dir>
#
# ROLLBACK (documented, kept on disk): devan-carlin's own W4A16 build
# (devan-carlin/Qwen3.8-Flash-Next-W4A16 @ 40b8f18d, 17 shards + PLE table).
# Same accuracy class as production on short rows, but weaker long-context
# recall — used only when AWQ must be abandoned.
#
# NOTE: the AWQ tree does NOT ship ple_table_qwen4exp.pt. Point PLE_TABLE_PATH
# at the W4A16 tree's table (it is a per-architecture MTP asset, not tied to
# the quantizer), and keep the W4A16 tree on disk for exactly this reason.
#
# start.sh identity-gates the paths (shards present, no symlinked snapshots).
MODEL_PATH="/path/to/Qwen3.8-Flash-Next-AWQ-W4A16"
PLE_TABLE_PATH="/path/to/Qwen3.8-Flash-Next-W4A16/ple_table_qwen4exp.pt"

# --- Serving identity ---------------------------------------------------------
# Name the API answers as (/v1/models, request "model" field).
SERVED_MODEL_NAME="qwen-256k"
PORT=8022

# --- Parallelism ----------------------------------------------------------------
# 4x Arc Pro B70 32GB, TP4+EP (2 KV heads — TP6 impossible).
TENSOR_PARALLEL_SIZE=4
ENABLE_EXPERT_PARALLEL=true

# --- Context & scheduler ---------------------------------------------------------
# MML 262144: 250,700-ptok needle CORRECT, ~97K x3 salted CORRECT.
MAX_MODEL_LEN=262144
# MNS 32 (verified operating point): 32x600 sustained 1,038.3 tok/s
# (gate >=900); ladder 2->95, 4->180, 8->335, 16->629; single-stream flat (52.5).
MAX_NUM_SEQS=32

# --- Engine line (byte-identical to verified boots) ------------------------------
DTYPE=bfloat16
KV_CACHE_DTYPE=fp8
GPU_MEMORY_UTILIZATION=0.85
REASONING_PARSER=qwen3
TOOL_CALL_PARSER=qwen3_xml
GENERATION_CONFIG=vllm
# Sampler pin: presence_penalty 1.5 is INTENTIONAL (part of the verified line).
# Temperature 0.7 is the ceiling for long-context fidelity: measured recall at
# <=0.7 holds the numbers in README "Results"; higher temperatures push
# misreads (see docs/hermes-clients.md "Temperature"). Do not raise it.
# Measurement harnesses neutralize samplers per-request; do not change the pin.
OVERRIDE_GENERATION_CONFIG='{"temperature": 0.7, "top_p": 0.80, "top_k": 20, "min_p": 0.0, "presence_penalty": 1.5, "repetition_penalty": 1.0}'

# --- Image (local build tag; or pin your own digest) ------------------------------
# Build: docker build -t qwen38-flash-next:local docker/
# The measured reference build was 15a806fc7367a44f6ab66d42e9f1b237fbb7431f4e913eb9ea197505f8d8417a
# (same Dockerfile source as this repo's docker/Dockerfile); a fresh host
# builds its own and points IMAGE at the local tag.
IMAGE="qwen38-flash-next:local"

# --- Engine environment (verified boot set — one variable per boot law) -----------
ZE_AFFINITY_MASK=0,1,2,3
ONEAPI_DEVICE_SELECTOR=level_zero:0,1,2,3
UR_L0_SYNC_MODE=BLOCKING
# COPY-OFFLOAD DISABLE — REQUIRED on B70 + 6.17.0-1010-intel. Without it the
# Level-Zero v2 copy engine (bcs) resets under prefix-cold load and freezes
# all 4 TP workers in async_tensor_h2d (3 freezes, 00:33/00:58/02:06 UTC
# 2026-10-04; 0 resets after). Evidence: docs/notes/gdn-l0-wedge.md,
# STATUS file "Why AWQ + the flag".
UR_L0_V2_FORCE_DISABLE_COPY_OFFLOAD=1
# CCL_ZE_CACHE_OPEN_IPC_HANDLES: leave UNSET. (=0 was suspected early; not
# required with the copy-offload disable, and an empty value crashes oneCCL
# worker init — see the pass-through note in start.sh.)
#CCL_ZE_CACHE_OPEN_IPC_HANDLES=0
VLLM_WORKER_MULTIPROC_METHOD=spawn
VLLM_XPU_ENABLE_XPU_GRAPH=1
MAX_JOBS=16

# --- Decode graph capture sizes (power-of-two, REQUIRED line) ----------------------
# Power-of-two capture sizes only: the boot of record passes the 1..64
# power-of-two ladder explicitly via EXTRA_VLLM_ARGS; keep this line when you
# change anything else (it is the measured decode-graph shape).
EXTRA_VLLM_ARGS='--cudagraph-capture-sizes 1 2 4 8 16 32 64'

# --- Container runtime --------------------------------------------------------------
CONTAINER_NAME=qwen38-flash-next
SHM_SIZE=16g
# Extra docker args passthrough (kept empty by default; the launch line is frozen).
EXTRA_DOCKER_ARGS=""

# --- Pre-boot XPU gate (MANDATORY) ----------------------------------------------------
# Trivial triton vector-add on one card must compile AND produce the exact
# result before any model boot (docker/gate.py). Catches every JIT gap in
# seconds. Double opt-out to skip (same discipline as the watchdog).
XPU_GATE_DISABLE=0

# --- Disk floors --------------------------------------------------------------
# Production AWQ tree ~169 GB; rollback W4A16 tree ~168 GB (both local).
# start.sh hard-gates a 2 GiB serving floor on the weights mount.
PREFLIGHT_DISK_GB=30           # report-only threshold for the weights mount
PREFLIGHT_ROOT_GB=40

# --- Preflight floors (validated host baseline; scripts/host-setup.sh installs it) ---
PREFLIGHT_XPU_COUNT=4
PREFLIGHT_RAM_GB=100
PREFLIGHT_SWAP_GB=64
READY_WAIT_SECONDS=900        # cold boots take ~4-5 min; 900 is generous

# --- Wedge watchdog (mandatory; double opt-out to disable) ----------------------------
# scripts/wedge-watchdog.sh: gen-probe liveness, LOAD-AWARE progress gate
# (prompt AND generation counters), py-spy capture first, restart via
# ./start.sh --launch, bounded retries, xe engine-reset monitor. Design:
# scripts/watchdog.md.
WEDGE_WATCHDOG_INTERVAL=60
WEDGE_WATCHDOG_RETRIES=3
WEDGE_WATCHDOG_DISABLE=0
