# ============================================================================
# .env.example — Qwen3.8-Flash-Next W4A16 on 4x Intel Arc Pro B70
#               SIDE-LANE STACK (deploy of record, 2026-09-23)
#
# cp .env.example .env — every value below is the measured/verified line
# (boots + soak + gates on this exact config, 2026-09-23). Knob meanings:
# README "Knobs"; limits + evidence: docs/.
#
# THIS IS THE THEIR-STACK LINE: vLLM fork devan-carlin/vllm@xpu-qwen4exp
# (a69fba21), image built FROM intel/omix:0.4.0-devel-ubuntu24.04.
# It is NOT the old sparse-QSA production stack (git history holds that kit)
# and NOT the fix-bundle image (that gates separately).
#
# Model-variant notice: this is the DENSE-FULL-CONTEXT QSA variant (indexer
# weights dropped) — a DIFFERENT model variant from the prior production
# sparse stack. Fidelity evidence: docs/evidence/2026-09-23-qsa-dense-verdict.md,
# docs/evidence/2026-09-23-sidelane-quicklook-mns16.md.
# ============================================================================

# --- Model & weights (local tree; bind-mounted read-only) --------------------
# Weights rev of record: 40b8f18d (W4A16 checkpoint + ple_table_qwen4exp.pt).
# No HF download — the tree lives on /data. start.sh identity-gates the paths.
MODEL_PATH="/data/hf-devan/Qwen3.8-Flash-Next-W4A16"
PLE_TABLE_PATH="/data/hf-devan/Qwen3.8-Flash-Next-W4A16/ple_table_qwen4exp.pt"

# --- Serving identity ---------------------------------------------------------
# Name the API answers as (/v1/models, request "model" field).
SERVED_MODEL_NAME="qwen-256k"
PORT=8022

# --- Parallelism ----------------------------------------------------------------
# 4x Arc Pro B70 32GB, TP4+EP (their recipe verbatim; 2 KV heads — TP6 impossible).
TENSOR_PARALLEL_SIZE=4
ENABLE_EXPERT_PARALLEL=true

# --- Context & scheduler ---------------------------------------------------------
# Their MML: 262144. Verified: 250,700-ptok needle CORRECT, ~97K x3 salted CORRECT.
MAX_MODEL_LEN=262144
# MNS 16 (2026-09-23 correction + gate): soak 16x600 sustained 626.3 tok/s
# (x3.45 vs MNS 4 = 181.7); 8x600 = 338.3 (x1.87); single-stream flat (52.5).
MAX_NUM_SEQS=16

# --- Engine line (their launch line, byte-identical to verified boots) ----------
DTYPE=bfloat16
KV_CACHE_DTYPE=fp8
GPU_MEMORY_UTILIZATION=0.85
REASONING_PARSER=qwen3
TOOL_CALL_PARSER=qwen3_xml
GENERATION_CONFIG=vllm
# Sampler pin (their recipe): presence_penalty 1.5 is INTENTIONAL (their stack).
# Measurement harnesses neutralize samplers per-request; do not change the pin.
OVERRIDE_GENERATION_CONFIG='{"temperature": 0.7, "top_p": 0.80, "top_k": 20, "min_p": 0.0, "presence_penalty": 1.5, "repetition_penalty": 1.0}'

# --- Image (pinned digest) --------------------------------------------------------
# Build of record (2026-09-23): local build via docker/sidelane/Dockerfile.
# NOT yet pushed to GHCR — the authenticated fresh-host pull test is an OPEN
# item. Until pushed, a fresh host must build the image (one command, README).
IMAGE="es-lane@sha256:15a806fc7367a44f6ab66d42e9f1b237fbb7431f4e913eb9ea197505f8d8417a"

# --- Engine environment (verified boot set — one variable per boot law) ----------
ZE_AFFINITY_MASK=0,1,2,3
ONEAPI_DEVICE_SELECTOR=level_zero:0,1,2,3
UR_L0_SYNC_MODE=BLOCKING
VLLM_WORKER_MULTIPROC_METHOD=spawn
VLLM_XPU_ENABLE_XPU_GRAPH=1
MAX_JOBS=16

# --- Container runtime --------------------------------------------------------------
CONTAINER_NAME=es-lane
SHM_SIZE=16g
# Extra docker args passthrough (kept empty by default; the launch line is frozen).
EXTRA_DOCKER_ARGS=""

# --- Pre-boot XPU gate (MANDATORY, standing rule 2026-09-23) -------------------------
# Trivial triton vector-add on one card must compile AND produce the exact
# result before any model boot (docker/sidelane/gate.py). Catches every JIT
# gap in seconds. Double opt-out to skip (same discipline as the watchdog).
XPU_GATE_DISABLE=0

# --- Disk floors --------------------------------------------------------------
# Weights are a LOCAL tree (bind-mounted read-only): no download headroom is
# needed. start.sh hard-gates only a 2 GiB serving floor on the weights mount;
# tight free space there is REPORT-ONLY (the rig's /data runs 92% and serves).
PREFLIGHT_DISK_GB=30           # report-only threshold for the weights mount
PREFLIGHT_ROOT_GB=40

# --- Preflight floors (platform of record; scripts/host-setup.sh installs it) --------
PREFLIGHT_XPU_COUNT=4
PREFLIGHT_RAM_GB=100
PREFLIGHT_SWAP_GB=64
READY_WAIT_SECONDS=900        # es-lane boots in ~4-5 min; 900 is generous

# --- Wedge watchdog (mandatory; double opt-out to disable) ----------------------------
# scripts/wedge-watchdog-eslane.sh: gen-probe liveness, py-spy capture first,
# restart via ./start.sh --launch, bounded retries.
WEDGE_WATCHDOG_INTERVAL=60
WEDGE_WATCHDOG_RETRIES=3
WEDGE_WATCHDOG_DISABLE=0
