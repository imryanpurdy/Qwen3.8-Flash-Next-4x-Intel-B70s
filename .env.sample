# ============================================================================
# Qwen3.8-Flash-Next-FP8 on 4x Intel Arc Pro B70 (TP4+EP4) — deploy-kit config
# ============================================================================
# Copy to .env and edit:
#   cp .env.sample .env
# .env is gitignored (HF_TOKEN and any local overrides stay out of git).
#
# Every annotated number below is a MEASURED lab value (campaign 2026-08-28 ->
# 09-01, protected anchors) taken from docs/lanes/ — nothing is invented here.
# Spec targets are marked as targets and never implied as achieved.
#
# Source of truth: docs/lanes/deploy-kit-contract.md (D4) + lane specs 1-4.

# -- Identity (frozen) -------------------------------------------------------
# Checkpoint identity (frozen): bcd9f01ddc9cff2316eb84281bebcd5b058bddce
# (125B-main / 6B-active MoE, 48-layer GDN+QSA, PLE n-gram 51B table,
#  185.56 GB tree / 131 shards). check-weights.sh prints this hash for
#  operator comparison and HARD-FAILS on wrong-model/mismatch.
MODEL_ID="Qwen/Qwen3.8-Flash-Next-FP8"

# Name exposed by the OpenAI-compatible endpoint (/v1/models, --served-model-name).
SERVED_MODEL_NAME="qwen3.8-flash-next"

# -- Server ------------------------------------------------------------------
PORT=8000
MAX_MODEL_LEN=4352            # lab launch identity: max_model_len 4352 (MTP3-4K cell).
                              # 8K contexts are NOT MTP-qualified (serve MTP0 3.98 tok/s only).

# -- Scheduler (measured anchors, do not raise blind) -------------------------
MAX_NUM_SEQS=1                # 1 seq is frozen in every lab launcher.
MAX_NUM_BATCHED_TOKENS=64     # LAB BASELINE, frozen in every lab launcher (docs/lanes/lane4):
                              # a 4K prefill at 64 = 64 serialized scheduler steps = TTFT 187.9 s.
                              # Lane 4 sweep 512/2048/4096 is PENDING; 8192 crashed the
                              # GLM-5.3 QSA indexer class. start.sh warns off 64, hard-fails >4096.

# -- Parallelism --------------------------------------------------------------
TENSOR_PARALLEL_SIZE=4        # TP4+EP4 = the frozen topology. TP must divide the 2 KV heads:
                              # TP ∈ {2,4,8} ONLY; TP6 is impossible (2 KV heads do not divide by 6).
ENABLE_EXPERT_PARALLEL=true   # EP4 = frozen topology.

# -- MTP speculative decoding -------------------------------------------------
MTP_NUM_SPECULATIVE_TOKENS=3  # k=3 IS THE 4K SERVING TARGET (docs/lanes/lane2 §3.1).
                              # MEASURED: MTP3 @4K 15.502 tok/s decode / TTFT 187.9 s
                              #           (PREFERRED 4K cell, 799/852 accepted);
                              #           MTP4 @512 20.727 tok/s (screen only, 1716/1716).
                              #           MTP3 @512 14.889 | MTP2 @512 11.895 | MTP1 @512 9.372
                              #           MTP0 @512 5.515783 (protected anchor).
                              # MTP4 @4K is QUARANTINED (engine stall 3,904/4,096) — do NOT
                              # serve k=4 at 4K until the Lane-2 gate clears (>= 18.0 tok/s).
                              # Set 0 to disable speculation (eager MTP0 baseline).

# -- PLE n-gram table host placement (frozen, synchronous pinned UVA) ---------
PLE_CPU_OFFLOAD_GB=12.25      # cpu_offload_gb=12.25 -> 12.22 GiB/rank (13,117,911,040 B) x 4
                              # ~= 51.2 GiB pinned host RAM (docs/lanes/00-shared-context §Subject).
                              # Synchronous pinned-UVA is the ONLY established placement; async
                              # UVA prefetch is REJECTED (A26/A27). This is why the host needs
                              # >= 100 GiB RAM + 64 GiB swap floors.

# -- Graphs (reserved knob) ---------------------------------------------------
GRAPH_MODE=eager              # eager until Lane 1 qualifies. Graphs are QUARANTINED-NEGATIVE
                              # (attempts a1-a7, 2026-08-28: host-RAM OOM during post-load
                              # compile, docs/lanes/lane1 §1). No other value is accepted by
                              # start.sh. No graph flag is passed in eager mode.

# -- Preflight floors (docs/lanes/deploy-kit-contract.md D2) ------------------
PREFLIGHT_XPU_COUNT=4         # exactly this many level_zero GPU devices (sycl-ls / /dev/dri)
PREFLIGHT_RAM_GB=100          # host usable-RAM (MemAvailable) floor, GiB
PREFLIGHT_SWAP_GB=64          # swap must be ON at >= this size (GiB)
PREFLIGHT_DISK_GB=200         # free space on the weights mount (checkpoint tree = 185.56 GB)
PREFLIGHT_ROOT_GB=40          # free space on / (graphs-era lab floor)

# -- Wedge watchdog (MANDATORY) -----------------------------------------------
# The Xe2 Level-Zero wedge kills the job every 2-6 h under load; only a
# container/engine restart recovers, and in-flight requests are lost.
# start.sh REFUSES to launch without the watchdog unless BOTH
# WEDGE_WATCHDOG_DISABLE=1 AND --no-preflight are given (double opt-out).
WEDGE_WATCHDOG_INTERVAL=60    # device/liveness probe cadence (seconds)
WEDGE_WATCHDOG_RETRIES=3      # bounded restarts before giving up loudly
# WEDGE_WATCHDOG_DISABLE=1    # uncomment ONLY together with `./start.sh --no-preflight`

# -- Docker image --------------------------------------------------------------
IMAGE="qwen38-flash-next-xpu:4xb70"   # default LOCAL build tag produced by ./build-image.sh

# -- HuggingFace ---------------------------------------------------------------
HF_TOKEN=""                   # never commit; stays in .env (gitignored)
# HF_HOME="/data/hf"          # optional; weights cache mount (default ~/.cache/huggingface).
                              # start.sh's disk preflight checks free space on this mount.

# -- Advanced ------------------------------------------------------------------
# EXTRA_VLLM_ARGS=""          # additional vLLM CLI args (word-split, appended last), e.g.
#   --reasoning-parser qwen3 --enable-thinking false        # lab identity: enable_thinking=false
#   --kv-cache-dtype bf16                                    # BLHNC cache identity
# EXTRA_DOCKER_ARGS=""        # additional `docker run` args (word-split), e.g. --ipc=host
