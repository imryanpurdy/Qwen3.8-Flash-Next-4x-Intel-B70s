# ============================================================================
# lumnus.env.example — engine env passed to the container (docker --env-file).
# Sanitized: production values retained, host-specific paths are container-side
# paths (fixed) or point at $LANE_CACHE. Derived from the Lumnus repo's
# engines/common.env + engines/awq-s16-kv128-chunked.env.
# Format: docker --env-file — no quotes, no variable expansion.
# Reference: Lumnus docs/switches.md (every switch documented there).
# ============================================================================

# ---- paths inside the container (fixed container-side; start.sh mounts them)
MODEL_DIR=/data/model
SERVE_CONFIG=/opt/b70-flashnext/serve-config.json

# ---- Level Zero / oneCCL on 4 cards (wu1ff's settings, engines/common.env)
ZE_AFFINITY_MASK=0,1,2,3
ONEAPI_DEVICE_SELECTOR=level_zero:0,1,2,3
ZE_FLAT_DEVICE_HIERARCHY=FLAT
CCL_SYCL_ALLGATHERV_TMP_BUF=1
CCL_SYCL_ALLREDUCE_TMP_BUF=1
CCL_ZE_IPC_EXCHANGE=sockets

# ---- REQUIRED on this kernel: Level-Zero copy-engine (bcs) reset workaround
# Without it the engine wedges (all TP workers stuck in async_tensor_h2d).
# The Lumnus series has no fix for this — it stays a driver-level workaround.
UR_L0_V2_FORCE_DISABLE_COPY_OFFLOAD=1

# ---- P7 peer-residency shim + vLLM XPU basics (engines/common.env)
LD_PRELOAD=/opt/b70-residency-shim/libl0_peer_residency_shim.so
VLLM_TARGET_DEVICE=xpu
VLLM_WORKER_MULTIPROC_METHOD=spawn
VLLM_XPU_ENABLE_XPU_GRAPH=1

# ---- offline; caches on the writable $LANE_CACHE volume (mounted /cache)
HF_HUB_OFFLINE=1
HF_DATASETS_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HOME=/cache/hf
TMPDIR=/cache/tmp
TRITON_CACHE_DIR=/cache/triton
VLLM_CACHE_ROOT=/cache/vllm
XDG_CACHE_HOME=/cache/xdg

# ---- PLE n-gram table: INT8 served from NVMe (patches 0006/0008/0013/0013b)
# BF16 table kept as the boot cross-check reference (B70_PLE_INT8_CROSSCHECK defaults 1).
PLE_TABLE_PATH=/ple/bf16/ple_table_qwen4exp.pt
# 0006: fill pinned PLE slabs from the mmap'ed file per rank (lower boot RAM peak).
B70_PLE_DIRECT_PINNED=1
# FP8 path explicitly off; exclusive with INT8.
B70_PLE_FP8=0
# INT8 rowscale table (0008): 48.9 GiB over 4 ranks instead of 95.4 GiB BF16.
B70_PLE_INT8=1
B70_PLE_INT8_PATH=/ple/int8/ple_ngram_int8_rowscale.safetensors
# 0013: serve the INT8 table from NVMe via an 8 GiB pinned row cache (native C reader).
B70_PLE_INT8_NVME=1
B70_PLE_INT8_NVME_PATH=/ple/int8/ple_ngram_int8_rowscale.safetensors
B70_PLE_INT8_NVME_CACHE_GIB=8
B70_PLE_INT8_NVME_IO_THREADS=16
B70_PLE_INT8_NVME_STATS=1
B70_PLE_INT8_NVME_READER=native
B70_PLE_INT8_NVME_LOOKAHEAD=0
B70_PLE_INT8_NVME_NATIVE_DIR=/cache/ple-nvme-native

# ---- chat defaults (0009/0010/0012)
# Per-effort thinking budgets (tokens).
B70_THINKING_BUDGET=minimal=512,low=512,medium=2048,high=4096,xhigh=8192,max=12288,ultra=12288,default=8192
# The sampler pins ride --override-generation-config in the serve args file
# (temperature 0.7 / top_p 0.80 / top_k 20 / min_p 0.0 / presence 1.5 / rep 1.0),
# so the server-side presence-penalty default stays 0 here (the explicit
# per-request value wins over these defaults anyway).
B70_DEFAULT_PRESENCE_PENALTY=0
# 0010: n-gram repetition stop (one token repeated 128x) — the safety net on
# top of the sampler pins; surfaces to clients as finish_reason=repetition.
B70_DEFAULT_REPETITION_DETECTION=max=1,min=1,count=128
# 0012: OpenRouter-style reasoning.effort alias.
B70_REASONING_EFFORT_ALIAS=1

# ---- KV-offload fix, 0014jb arm
B70_OFFLOAD_TRACE=1
B70_OFFLOAD_TRACE_PERIOD_S=60
# 0014b: pin a shared-prefix junction where a Mamba/GDN group cuts an offload hit.
B70_OFFLOAD_JUNCTION=1
# 0014c: retain GDN states one block below the replay boundary.
B70_OFFLOAD_GDN_BACKSTEP=1
# 0014d/e/f stay OFF in this arm.
B70_OFFLOAD_EMPTY_ADVANCE_GUARD=0
B70_OFFLOAD_GROUP_EVICT=0

# ---- pinned host memory: do not cache >1 GiB pinned staging blocks
PYTORCH_ALLOC_CONF=pinned_max_cached_size_mb:1024
