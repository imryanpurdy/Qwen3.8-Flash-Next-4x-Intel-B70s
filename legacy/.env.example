# ============================================================================
# .env.example — Qwen3.8-Flash-Next INT4 W4A16 on 4x Intel Arc Pro B70 (v1)
#
# cp .env.example .env   — every value below is the measured production line
# (2026-09-22/23). Knob meanings: README "Knobs"; limits + evidence: docs/.
# ============================================================================

# --- Model & serving identity -----------------------------------------------
# HuggingFace repo (identity-gated pre-launch by check-weights.sh;
# tree identity bcd9f01ddc9cff2316eb84281bebcd5b058bddce).
MODEL_ID="Intel/Qwen3.8-Flash-Next-W4A16-AutoRound"
# Name the API answers as (/v1/models, request "model" field).
SERVED_MODEL_NAME="qwen3.8-flash-next"
# Published API port (host and container; published via EXTRA_DOCKER_ARGS).
PORT=8021

# --- Parallelism -------------------------------------------------------------
# 4x Arc Pro B70 32GB. TP must divide the 2 KV heads: only {2,4,8} valid.
TENSOR_PARALLEL_SIZE=4
# Expert parallel on; all2all backend pinned in start.sh (allgather_reducescatter,
# frozen EP4 identity). Set false only if you know why.
ENABLE_EXPERT_PARALLEL=true

# --- Context & scheduler -----------------------------------------------------
# Measured ceiling: 98304 passes; 130K dies mid-prefill; 170K DEVICE_LOST
# (error-20, PLE staging). start.sh refuses values above 98304.
MAX_MODEL_LEN=98304
# Concurrent sequences. Decode graphs must cover this width (see CAP_SIZES_LIST).
MAX_NUM_SEQS=16
# Batched-token budget per step. >4096 = crash class (QSA indexer); 2048 = v1.
MAX_NUM_BATCHED_TOKENS=2048

# --- Speculative decoding ----------------------------------------------------
# 0 = disabled: the validated line. 1 produces corrupted output on this image
# (temp-0 A/B, ledger B5-DISCRIMINATOR). start.sh refuses non-zero.
MTP_NUM_SPECULATIVE_TOKENS=0

# --- PLE n-gram offload -------------------------------------------------------
# Host-side PLE table per rank; 1.0 GiB knob pins ~12.2 GiB/rank UVA host table
# (~51 GiB total host RAM on top of the 4x ~31 GiB device loads).
PLE_CPU_OFFLOAD_GB=1.0
# 0 keeps the NVIDIA pin-memory path off (XPU uses UVA).
VLLM_WEIGHT_OFFLOADING_DISABLE_PIN_MEMORY=0

# --- Decode graphs ------------------------------------------------------------
# Comma list of decode batch sizes to capture (FULL_DECODE_ONLY). MUST contain
# MAX_NUM_SEQS: an aligned decode batch at an uncaptured size falls back to
# eager (the v24h 5x cliff). 1..16 + 24,32 = the 320-boot capture set;
# transitional sizes 9..11,13..15,17..23 fault at capture on this stack.
CAP_SIZES_LIST=1,2,3,4,5,6,7,8,12,16,24,32
# Legacy knob, kept for v1-config fidelity: older launchers branch on it. The
# graph mechanism on this stack is VLLM_XPU_ENABLE_XPU_GRAPH=1 + -O 0 (below).
GRAPH_MODE=eager

# --- KV cache ------------------------------------------------------------------
# Exact KV pool bytes/rank. Removing the knob re-derives the pool and taxes
# every decode step via PLE gather (measured 2026-09-22). 9,494,279,680 B
# = 8.84 GiB.
EXTRA_VLLM_ARGS=" --kv-cache-memory-bytes 9494279680 --enable-ep-weight-filter --quantization inc -O 0 --gpu-memory-utilization 0.75 --enable-auto-tool-choice --tool-call-parser qwen3_xml --reasoning-parser qwen3 --long-prefill-token-threshold 1024"

# --- Image (pinned, no local build) --------------------------------------------
# GHCR manifest digest of stage-v24h2:rollback-t120 (vLLM XPU runtime +
# production patch overlay + ONE-LINE t120 delta: PLE staging deadline
# 2.0s -> 120.0s, connector.py:370). Image ID sha256:0ca85985...66fc2.
# Pull proof: ghcr.io/imryanpurdy/qwen38-flash-next-b70@<digest> -> 0ca8598598ba (2026-09-23).
# Reproduce it from source: files/overlay/Dockerfile.t120.
# NOTE: package is private — `docker login ghcr.io` before first pull.
IMAGE="ghcr.io/imryanpurdy/qwen38-flash-next-b70@sha256:0ca8598598ba84614dede126141070665fbaf3c68205c0b8567cddb2dca66fc2"

# --- Runtime container args (v1 production set, keep in order) ------------------
# SYS_RESOURCE: WNA16 compile path. V2 runner envs: the validated model-runner
# generation. KV layout BLHNC. Faulthandler for py-spy post-mortems. PLE
# offload + GDN serial-spec flags: the t120-era connector contract.
# CCL_ZE_CACHE_OPEN_IPC_HANDLES=0 is PERMANENT (oneCCL #212): stale cached
# Level-Zero IPC handle -> GPU page fault + permanent hang in
# ze_base_entry::is_event_completed (Battlemage, world_size>=2). No fix in
# oneCCL 2021.x/2022.x release notes. Measured cost at n=4: undetectable.
# Do NOT strip as legacy.
EXTRA_DOCKER_ARGS="--cap-add SYS_RESOURCE -e VLLM_XPU_ENABLE_XPU_GRAPH=1 -e VLLM_USE_V2_MODEL_RUNNER=1 -e VLLM_KV_CACHE_LAYOUT=BLHNC -p 8021:8021 -e PYTHONFAULTHANDLER=1 -e VLLM_PLE_CPU_OFFLOAD=1 -e VLLM_XPU_GDN_SERIAL_SPEC_DECODE=0 -e VLLM_XPU_GDN_NATIVE_SPEC_RECURRENT_SERIAL_EXACT=1 -e VLLM_SPU_GDN_SPEC_PERSISTENT_SCRATCH=1 -e VLLM_XPU_GDN_NATIVE_SPEC_COMPLETION_BARRIER=1 -e VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS=900 -e CCL_ZE_CACHE_OPEN_IPC_HANDLES=0"

# --- Weights cache --------------------------------------------------------------
# Where the ~186 GB HF tree lives. MUST have >= 30 GiB free beyond the tree.
HF_HOME="/home/bonz/hf-int4"
# Public model — leave empty. Only needed for gated/private repos.
HF_TOKEN=""

# --- Wedge watchdog (mandatory; double opt-out to disable) ----------------------
# Probes gen-probe + log liveness every N seconds; on wedge: py-spy capture
# FIRST, then restart via ./start.sh --launch (bounded retries).
WEDGE_WATCHDOG_INTERVAL=60
WEDGE_WATCHDOG_RETRIES=3
WEDGE_WATCHDOG_DISABLE=0

# --- Preflight floors ------------------------------------------------------------
PREFLIGHT_XPU_COUNT=4
PREFLIGHT_RAM_GB=100
PREFLIGHT_SWAP_GB=64
PREFLIGHT_DISK_GB=30
PREFLIGHT_ROOT_GB=40

# --- Derived (do not set) --------------------------------------------------------
CONTAINER_NAME=qwen38-flash-next
SHM_SIZE=16g
